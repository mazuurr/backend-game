{
    "name": "app/user-api",
    "description": "User Management API - Symfony DDD + CQRS",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "symfony/framework-bundle": "^7.2",
        "symfony/routing": "^7.2",
        "symfony/security-bundle": "^7.2",
        "symfony/messenger": "^7.2",
        "symfony/mailer": "^7.2",
        "symfony/uid": "^7.2",
        "symfony/dotenv": "^7.2",
        "symfony/yaml": "^7.2",
        "symfony/runtime": "^7.2",
        "doctrine/orm": "^3.3",
        "doctrine/doctrine-bundle": "^2.13",
        "doctrine/doctrine-migrations-bundle": "^3.4",
        "lexik/jwt-authentication-bundle": "^3.1",
        "symfony/twig-bundle": "^7.4",
        "nelmio/cors-bundle": "^2.6",
        "workerman/workerman": "^4.1",
        "nelmio/api-doc-bundle": "^5.12",
        "symfony/asset": "^7.4"
    },
    "require-dev": {
        "symfony/maker-bundle": "^1.62",
        "symfony/debug-bundle": "^7.2",
        "symfony/var-dumper": "^7.2",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "DoctrineMigrations\\": "migrations/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "XDEBUG_MODE=coverage phpunit --coverage-text --coverage-clover=var/coverage.xml"
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        }
    },
    "extra": {
        "runtime": {
            "dotenv_path": ".env"
        }
    }
}
