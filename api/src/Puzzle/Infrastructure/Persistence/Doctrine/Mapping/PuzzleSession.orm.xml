<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                  https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Puzzle\Domain\Entity\PuzzleSession" table="puzzle_sessions">

        <id name="id" type="integer" column="id">
            <generator strategy="IDENTITY"/>
        </id>

        <field name="uuid" type="puzzle_session_id" column="uuid" length="36" unique="true"/>
        <field name="puzzleUuid" type="puzzle_id" column="puzzle_uuid" length="36"/>
        <field name="visibility" type="string" column="visibility" length="16"/>
        <field name="groupUuid" type="group_id" column="group_uuid" length="36" nullable="true"/>
        <field name="createdByUserUuid" type="user_id" column="created_by_user_uuid" length="36"/>
        <field name="status" type="string" column="status" length="16"/>
        <field name="createdAt" type="datetime_immutable" column="created_at"/>
        <field name="expiresAt" type="datetime_immutable" column="expires_at"/>
        <field name="closedAt" type="datetime_immutable" column="closed_at" nullable="true"/>

        <indexes>
            <index columns="status" name="idx_session_status"/>
            <index columns="expires_at" name="idx_session_expires_at"/>
        </indexes>

    </entity>

</doctrine-mapping>
