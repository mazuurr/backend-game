<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                  https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Puzzle\Domain\Entity\PuzzleSessionStat" table="puzzle_session_stats">

        <id name="id" type="integer" column="id">
            <generator strategy="IDENTITY"/>
        </id>

        <field name="sessionUuid" type="puzzle_session_id" column="session_uuid" length="36" unique="true"/>
        <field name="puzzleUuid" type="puzzle_id" column="puzzle_uuid" length="36"/>
        <field name="createdByUserUuid" type="user_id" column="created_by_user_uuid" length="36"/>
        <field name="mode" type="string" column="mode" length="16"/>
        <field name="totalPieces" type="integer" column="total_pieces"/>
        <field name="correctPieces" type="integer" column="correct_pieces"/>
        <field name="timeSpentSeconds" type="integer" column="time_spent_seconds"/>
        <field name="startedAt" type="datetime_immutable" column="started_at"/>
        <field name="finishedAt" type="datetime_immutable" column="finished_at"/>
        <field name="recordedAt" type="datetime_immutable" column="recorded_at"/>

        <indexes>
            <index columns="created_by_user_uuid" name="idx_session_stat_user"/>
        </indexes>

    </entity>

</doctrine-mapping>
