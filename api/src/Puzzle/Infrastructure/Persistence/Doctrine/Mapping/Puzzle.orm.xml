<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                  https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Puzzle\Domain\Entity\Puzzle" table="puzzles">

        <id name="id" type="integer" column="id">
            <generator strategy="IDENTITY"/>
        </id>

        <field name="uuid" type="puzzle_id" column="uuid" unique="true" length="36"/>
        <field name="originalName" type="string" column="original_name" length="255"/>
        <field name="storedFilename" type="string" column="stored_filename" length="255"/>
        <field name="mimeType" type="string" column="mime_type" length="100"/>
        <field name="size" type="integer" column="size"/>
        <field name="difficulty" type="integer" column="difficulty" nullable="true"/>
        <field name="totalPieces" type="integer" column="total_pieces" nullable="true"/>
        <field name="piecesPerFragment" type="integer" column="pieces_per_fragment" nullable="true"/>
        <field name="piecesX" type="integer" column="pieces_x" nullable="true"/>
        <field name="piecesY" type="integer" column="pieces_y" nullable="true"/>
        <field name="createdAt" type="datetime_immutable" column="created_at"/>

    </entity>

</doctrine-mapping>
