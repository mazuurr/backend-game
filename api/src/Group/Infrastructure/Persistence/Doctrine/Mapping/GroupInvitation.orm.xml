<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                  https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Group\Domain\Entity\GroupInvitation" table="group_invitations">

        <id name="id" type="integer" column="id">
            <generator strategy="IDENTITY"/>
        </id>

        <field name="uuid" type="group_invitation_id" column="uuid" unique="true" length="36"/>
        <field name="groupUuid" type="group_id" column="group_uuid" length="36"/>
        <field name="userUuid" type="user_id" column="user_uuid" length="36"/>
        <field name="type" type="string" column="type" length="20"/>
        <field name="status" type="string" column="status" length="20"/>
        <field name="initiatorUuid" type="user_id" column="initiator_uuid" length="36"/>
        <field name="createdAt" type="datetime_immutable" column="created_at"/>
        <field name="respondedAt" type="datetime_immutable" column="responded_at" nullable="true"/>

        <indexes>
            <index columns="group_uuid" name="idx_group_invitations_group"/>
            <index columns="user_uuid" name="idx_group_invitations_user"/>
            <index columns="status" name="idx_group_invitations_status"/>
        </indexes>

    </entity>

</doctrine-mapping>
